{
  "name": "guided-reviews",
  "displayName": "Guided Reviews",
  "description": "Review your own commits locally, with an AI-guided narrative and comment threads a coding agent can read and reply to.",
  "version": "0.1.0",
  "publisher": "marksalpeter",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/marksalpeter/guided-reviews.git"
  },
  "engines": {
    "node": ">=20",
    "vscode": "^1.90.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "icon": "media/icon.png",
  "main": "./dist/extension.js",
  "bin": {
    "review": "./dist/cli.js"
  },
  "activationEvents": [
    "onStartupFinished",
    "onUri"
  ],
  "contributes": {
    "commands": [
      {
        "command": "guidedReviews.openReview",
        "title": "Open Review",
        "category": "Guided Reviews"
      },
      {
        "command": "guidedReviews.installAgentSupport",
        "title": "Install Agent Skill and CLI",
        "category": "Guided Reviews"
      },
      {
        "command": "guidedReviews.deleteReview",
        "title": "Delete Review",
        "category": "Guided Reviews"
      },
      {
        "command": "guidedReviews.focusComment",
        "title": "Open Comment",
        "category": "Guided Reviews",
        "enablement": "false"
      }
    ],
    "keybindings": [
      {
        "command": "guidedReviews.openReview",
        "key": "alt+shift+r",
        "mac": "alt+shift+r",
        "when": "!terminalFocus"
      }
    ],
    "configuration": {
      "title": "Guided Reviews",
      "properties": {
        "guidedReviews.defaultBranch": {
          "type": "string",
          "default": "",
          "description": "Override the detected default branch (e.g. 'main'). Empty means auto-detect."
        },
        "guidedReviews.claudePath": {
          "type": "string",
          "default": "claude",
          "description": "Path to the Claude Code CLI used to generate guided reviews."
        },
        "guidedReviews.model": {
          "type": "string",
          "default": "claude-opus-5",
          "description": "Model passed to Claude Code when generating a guided review."
        },
        "guidedReviews.autoGenerateGuide": {
          "type": "boolean",
          "default": true,
          "description": "Generate the guided review automatically when a review is opened."
        }
      }
    },
    "customEditors": [
      {
        "viewType": "guidedReviews.comment",
        "displayName": "Guided Reviews Comment",
        "selector": [
          {
            "filenamePattern": "**/.guided-review/comments/*.comment"
          }
        ],
        "priority": "default"
      }
    ]
  },
  "scripts": {
    "build": "npm run build:webview && npm run build:node",
    "build:node": "node esbuild.mjs",
    "build:webview": "vite build",
    "gen:grammars": "node scripts/gen-grammars.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.webview.json",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "npm run build && vsce package --no-rewrite-relative-links",
    "dev:install": "npm run package && code --install-extension guided-reviews-$npm_package_version.vsix --force",
    "vscode:prepublish": "npm run build"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/vscode": "^1.90.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.24.0",
    "eslint": "^9.17.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.63.0",
    "react": "^19.0.0",
    "react-diff-view": "^3.3.3",
    "react-dom": "^19.0.0",
    "shiki": "^4.4.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vitest": "^5.0.0"
  }
}
